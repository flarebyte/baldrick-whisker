{
  "name": "baldrick-whisker",
  "description": "Code generator for Elm and Typescript using templates",
  "version": "0.12.0",
  "author": {
    "name": "Olivier Huin",
    "url": "https://github.com/olih"
  },
  "keywords": [
    "CLI",
    "template",
    "mustache",
    "handlebars",
    "elm",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/flarebyte/baldrick-whisker",
  "repository": {
    "type": "git",
    "url": "https://github.com/flarebyte/baldrick-whisker.git"
  },
  "bugs": "https://github.com/flarebyte/baldrick-whisker/issues",
  "bin": {
    "baldrick-whisker": "dist/src/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/cli.mjs",
      "default": "./dist/cli.mjs",
      "types": "./src"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "test": "tsx --test test/*.test.ts",
    "cli": "tsx src/cli.mts",
    "test:cov": "c8 --reporter=text-summary --reporter=lcov yarn -s test"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "pest-spec/**",
      "spec/**",
      "src/model.ts",
      "src/json-model.ts",
      "**/*.d.ts"
    ]
  },
  "dependencies": {
    "commander": "^9.4.1",
    "fs-jetpack": "^5.1.0",
    "handlebars": "^4.7.7",
    "octokit": "^2.0.10",
    "papaparse": "^5.3.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/papaparse": "^5.3.16",
    "@types/prompts": "^2.4.9",
    "baldrick-dev-ts": "^1.0.0",
    "baldrick-tsconfig-es2024": "^0.5.0",
    "c8": "^10.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {}
}
